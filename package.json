{
  "name": "nestful",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WeChat-first family management MVP.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:api": "corepack pnpm --filter @nestful/api dev",
    "acceptance:smoke": "node scripts/acceptance-smoke.mjs",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "fastify": "^5.0.0"
  }
}
