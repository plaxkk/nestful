<view class="page family-page">
  <view class="panel family-header">
    <text class="title">{{familyName}}</text>
    <text class="subtitle">这里是家里的小本子。先把家人邀请进来。</text>
    <button class="primary-action" bindtap="onCreateInvitation">第 2 步：邀请家人</button>
    <button class="secondary-action" bindtap="onOpenReminders">查看生日和健康提醒</button>
  </view>

  <view class="panel invite-panel" wx:if="{{inviteCode}}">
    <text class="section-title">邀请已准备好</text>
    <text class="invite-code">{{inviteCode}}</text>
    <text class="hint">点下面按钮，发给家人。家人打开后填写称呼就能加入。</text>
    <button class="secondary-action" open-type="share">发给家人</button>
  </view>

  <view class="section">
    <text class="section-title">家里人</text>
    <view class="member-list">
      <view class="member-row" wx:for="{{members}}" wx:key="id">
        <view class="avatar">{{item.avatarText}}</view>
        <view class="member-main">
          <text class="member-name">{{item.displayName}}</text>
          <text class="member-meta">{{item.roleLabel}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
