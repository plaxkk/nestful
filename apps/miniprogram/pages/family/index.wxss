.family-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.family-header {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.title {
  color: #1f2a24;
  font-size: 52rpx;
  font-weight: 700;
}

.subtitle,
.hint {
  color: #5d6b63;
  font-size: 34rpx;
  line-height: 1.6;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-title {
  color: #1f2a24;
  font-size: 38rpx;
  font-weight: 700;
}

.invite-panel {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.invite-code {
  color: #22745f;
  font-size: 46rpx;
  font-weight: 700;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.member-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 30rpx;
  border: 2rpx solid #d8e5df;
  border-radius: 8rpx;
  background: #ffffff;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e0eee7;
  color: #22745f;
  font-size: 38rpx;
  font-weight: 700;
}

.member-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.member-name {
  color: #1f2a24;
  font-size: 36rpx;
  font-weight: 600;
}

.member-meta {
  color: #5d6b63;
  font-size: 30rpx;
}
