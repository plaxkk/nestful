.family-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  background: #fff8f6;
}

.family-hero {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 28rpx;
}

.eyebrow {
  color: #9a4b2f;
  font-size: 30rpx;
  font-weight: 700;
}

.member-pill {
  align-self: flex-start;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #ffe9e4;
  color: #432a25;
  font-size: 30rpx;
  font-weight: 700;
}

.invite-panel,
.invite-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.invite-icon {
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #041627;
  font-size: 42rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 36rpx rgba(78, 52, 46, 0.08);
}

.center {
  text-align: center;
}

.code-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 18rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 24rpx;
  background: #fff8f6;
}

.code-label {
  color: #74777d;
  font-size: 30rpx;
  font-weight: 800;
}

.code-row {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.code-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 96rpx;
  border: 2rpx solid #ffdad2;
  border-radius: 16rpx;
  background: #ffffff;
  color: #041627;
  font-size: 54rpx;
  font-weight: 800;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.feature-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 28rpx 30rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(78, 52, 46, 0.04);
}

.feature-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.feature-title {
  color: #2b1611;
  font-size: 34rpx;
  font-weight: 800;
}

.feature-desc {
  color: #63635f;
  font-size: 30rpx;
  line-height: 1.4;
}

.feature-arrow {
  color: #041627;
  font-size: 50rpx;
  font-weight: 700;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.member-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 30rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 24rpx;
  background: #ffffff;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #ffe9e4;
  color: #041627;
  font-size: 38rpx;
  font-weight: 800;
}

.member-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.member-name {
  color: #2b1611;
  font-size: 36rpx;
  font-weight: 800;
}

.member-meta {
  color: #63635f;
  font-size: 30rpx;
  line-height: 1.4;
}

.invitation-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.invitation-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 24rpx;
  background: #ffffff;
}

.invitation-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.invitation-code {
  color: #2b1611;
  font-size: 34rpx;
  font-weight: 800;
}

.invitation-meta {
  color: #63635f;
  font-size: 28rpx;
  line-height: 1.4;
}

.small-danger-button {
  min-width: 116rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 2rpx solid #b3261e;
  border-radius: 18rpx;
  background: #ffffff;
  color: #b3261e;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.member-editor {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.text-button {
  min-width: 108rpx;
  min-height: 70rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  background: transparent;
  color: #041627;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 70rpx;
}

.danger-action {
  width: 100%;
  min-height: 98rpx;
  margin: 0;
  border: 3rpx solid #b3261e;
  border-radius: 24rpx;
  background: #ffffff;
  color: #b3261e;
  font-size: 34rpx;
  font-weight: 800;
}
