.family-hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
}
.family-hero>.primary-action {
  margin-top: 10rpx;
}
.member-pill {
  font-size: 25rpx;
  color: var(--brand);
}
.family-list-link {
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 0;
  background: transparent;
  color: var(--brand);
  font-size: 27rpx;
  text-align: left;
}
.invite-panel,.invite-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.invite-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--soft-green);
  color: var(--brand);
  border-radius: 24rpx;
  font-size: 36rpx;
}
.code-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 26rpx;
  background: var(--sand);
  border-radius: 22rpx;
}
.code-label {
  font-size: 24rpx;
  color: var(--clay);
}
.invite-token {
  font-size: 34rpx;
  letter-spacing: 3rpx;
  word-break: break-all;
}
.invitation-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.invitation-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.invitation-code {
  font-size: 29rpx;
}
.invitation-meta {
  font-size: 25rpx;
  color: var(--muted-ink);
}
.small-danger-button {
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 20rpx;
  background: transparent;
  color: #9b4b33;
  font-size: 27rpx;
}
.member-list,.feature-list {
  display: flex;
  flex-direction: column;
}
.member-row,.feature-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 120rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
  box-sizing: border-box;
}
.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: var(--soft-green);
  color: var(--brand);
  font-size: 32rpx;
}
.member-main,.feature-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.member-name,.feature-title {
  font-size: 31rpx;
  font-weight: 500;
  word-break: break-all;
}
.member-meta,.feature-desc {
  font-size: 25rpx;
  color: var(--muted-ink);
  word-break: break-all;
}
.feature-arrow {
  color: var(--muted-ink);
  font-size: 36rpx;
}
.settings-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--brand);
  font-size: 25rpx;
  text-align: left;
}

.family-page .family-list-link { display: flex; align-items: center; justify-content: flex-start; width: auto; max-width: 100%; }
