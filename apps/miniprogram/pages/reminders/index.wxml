<view class="page reminders-page">
  <view class="panel header">
    <text class="page-title">生日和健康提醒</text>
    <text class="page-subtitle">吃药要指定到人；运动可以给一个人，也可以给全家；生日可以提前提醒，也可以当天推送。</text>
  </view>

  <view class="panel form-panel">
    <text class="section-title">新增一个提醒</text>
    <view class="field">
      <text class="label">提醒类型</text>
      <picker mode="selector" range="{{reminderTypes}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker-value">{{reminderTypes[typeIndex].label}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">{{reminderTypes[typeIndex].value === 'exercise' && targetScopeOptions[targetScopeIndex].value === 'family' ? '负责人' : '提醒对象'}}</text>
      <picker mode="selector" range="{{memberOptions}}" value="{{memberIndex}}" bindchange="onMemberChange">
        <view class="picker-value">{{memberOptions[memberIndex] || '还没有家庭成员'}}</view>
      </picker>
    </view>

    <view class="field" wx:if="{{reminderTypes[typeIndex].value === 'exercise'}}">
      <text class="label">运动范围</text>
      <picker mode="selector" range="{{targetScopeOptions}}" range-key="label" value="{{targetScopeIndex}}" bindchange="onTargetScopeChange">
        <view class="picker-value">{{targetScopeOptions[targetScopeIndex].label}}</view>
      </picker>
    </view>

    <view class="field" wx:if="{{reminderTypes[typeIndex].value !== 'birthday'}}">
      <text class="label">提醒内容</text>
      <input class="input" value="{{titleInput}}" bindinput="onTitleInput" placeholder="例如：降压药、散步 20 分钟" />
    </view>

    <view class="field" wx:if="{{reminderTypes[typeIndex].value !== 'birthday'}}">
      <text class="label">频次</text>
      <picker mode="selector" range="{{frequencyOptions}}" range-key="label" value="{{frequencyIndex}}" bindchange="onFrequencyChange">
        <view class="picker-value">{{frequencyOptions[frequencyIndex].label}}</view>
      </picker>
    </view>

    <view class="field" wx:if="{{reminderTypes[typeIndex].value !== 'birthday'}}">
      <text class="label">第一次提醒时间</text>
      <input class="input" value="{{dueAtInput}}" bindinput="onDueAtInput" placeholder="例如：2026-06-09 08:00" />
    </view>

    <view class="field" wx:if="{{reminderTypes[typeIndex].value === 'birthday'}}">
      <text class="label">出生日期</text>
      <input class="input" value="{{birthdayDateInput}}" bindinput="onBirthdayDateInput" placeholder="例如：1965-03-12" />
    </view>

    <view class="field" wx:if="{{reminderTypes[typeIndex].value === 'birthday'}}">
      <text class="label">提前多久提醒</text>
      <picker mode="selector" range="{{advanceDayOptions}}" range-key="label" value="{{advanceDayIndex}}" bindchange="onAdvanceDayChange">
        <view class="picker-value">{{advanceDayOptions[advanceDayIndex].label}}</view>
      </picker>
    </view>

    <view class="switch-row" wx:if="{{reminderTypes[typeIndex].value === 'birthday'}}">
      <text class="label">生日当天也推送</text>
      <switch checked="{{notifyOnBirthday}}" bindchange="onNotifyOnBirthdayChange" />
    </view>

    <button class="primary-action" bindtap="onCreateReminder">保存提醒</button>
  </view>

  <view class="section">
    <text class="section-title">家里的提醒</text>
    <text class="empty-text" wx:if="{{!loading && reminders.length === 0}}">还没有提醒。先新增一个生日、吃药或运动提醒。</text>
    <view class="reminder-list">
      <view class="reminder-row {{item.isCompleted ? 'completed' : ''}}" wx:for="{{reminders}}" wx:key="id">
        <view class="reminder-main">
          <text class="reminder-title">{{item.title}}</text>
          <text class="reminder-meta">{{item.typeLabel}} · {{item.dueAtText}} · {{item.statusLabel}}</text>
        </view>
        <button wx:if="{{!item.isCompleted}}" class="complete-button" data-id="{{item.id}}" bindtap="onCompleteReminder">完成</button>
      </view>
    </view>
  </view>
</view>
