.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.reminder-row {
  padding: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
}
.reminder-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}
.reminder-title {
  font-size: 33rpx;
  font-weight: 500;
  word-break: break-all;
}
.reminder-meta {
  font-size: 26rpx;
  color: var(--muted-ink);
  line-height: 1.75;
}
.reminder-row>.action-row {
  margin-top: 16rpx;
}
.completed .reminder-title {
  color: var(--muted-ink);
}
.date-time-row>picker {
  flex: 1;
  min-width: 180rpx;
}

.reminder-row.focused { border-color: #365b44; }
