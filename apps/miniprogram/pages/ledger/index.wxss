.ledger-page {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  background: #fff8f6;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 18rpx 4rpx 8rpx;
}

.form-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  border-color: #ffe2db;
  background: #ffffff;
}

.eyebrow {
  color: #9a4b2f;
  font-size: 30rpx;
  font-weight: 800;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.summary-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 280rpx;
  min-height: 160rpx;
  padding: 26rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 24rpx;
  background: #ffffff;
}

.summary-card.primary {
  flex-basis: 100%;
  background: #ffe9e4;
  border-color: #ffdad2;
}

.summary-label {
  color: #44474c;
  font-size: 30rpx;
  font-weight: 800;
}

.summary-value {
  color: #2b1611;
  font-size: 46rpx;
  font-weight: 800;
}

.summary-value.income {
  color: #041627;
}

.summary-value.expense {
  color: #9a4b2f;
}

.summary-helper {
  color: #44474c;
  font-size: 30rpx;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-heading {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.section-title {
  color: #2b1611;
  font-size: 38rpx;
  font-weight: 800;
}

.section-note {
  color: #44474c;
  font-size: 30rpx;
  line-height: 1.5;
}

.picker-value {
  min-height: 104rpx;
  padding: 0 24rpx;
  border: 2rpx solid #c4c6cd;
  border-radius: 24rpx;
  background: #ffffff;
  color: #2b1611;
  font-size: 36rpx;
  line-height: 104rpx;
}

.empty-text {
  padding: 30rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 24rpx;
  background: #ffffff;
  color: #44474c;
  font-size: 32rpx;
  line-height: 1.6;
}

.ledger-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ledger-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 30rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 24rpx;
  background: #ffffff;
}

.ledger-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  font-size: 30rpx;
  font-weight: 800;
}

.ledger-mark.income {
  background: #ffe9e4;
  color: #041627;
}

.ledger-mark.expense {
  background: #ffe2db;
  color: #9a4b2f;
}

.ledger-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ledger-title {
  color: #2b1611;
  font-size: 36rpx;
  font-weight: 800;
}

.ledger-meta {
  color: #44474c;
  font-size: 30rpx;
  line-height: 1.5;
}

.ledger-amount {
  min-width: 170rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 800;
}

.ledger-amount.income {
  color: #041627;
}

.ledger-amount.expense {
  color: #9a4b2f;
}
