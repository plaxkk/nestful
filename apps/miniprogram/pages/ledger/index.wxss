.summary-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 30rpx;
  background: var(--sand);
  border-radius: 32rpx;
}
.summary-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
  padding-top: 24rpx;
}
.summary-card.primary {
  flex: none;
  width: 100%;
  padding-top: 0;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #decfb8;
}
.summary-label {
  font-size: 26rpx;
  color: #795332;
}
.summary-value {
  font-size: 36rpx;
  font-weight: 500;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}
.primary .summary-value {
  font-size: 58rpx;
  line-height: 1.4;
}
.summary-helper {
  font-size: 24rpx;
  color: var(--muted-ink);
}
.ledger-list,.mini-list {
  display: flex;
  flex-direction: column;
}
.ledger-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.ledger-mark {
  display: none;
}
.ledger-main {
  flex: 1;
  min-width: 220rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.ledger-title,.mini-title {
  font-size: 31rpx;
  font-weight: 500;
  word-break: break-all;
}
.ledger-meta,.mini-meta {
  font-size: 25rpx;
  color: var(--muted-ink);
  line-height: 1.8;
  word-break: break-all;
}
.ledger-amount,.mini-amount {
  font-size: 32rpx;
  font-weight: 500;
  word-break: break-all;
}
.expense {
  color: #925938;
}
.income {
  color: var(--brand);
}
.mini-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.mini-main {
  flex: 1;
  min-width: 220rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.summary-totals { display: flex; gap: 30rpx; }
.ledger-amount { max-width: 100%; }
