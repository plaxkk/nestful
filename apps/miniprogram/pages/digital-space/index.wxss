.item-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.item-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
}
.item-mark {
  padding: 6rpx 14rpx;
  background: var(--soft-green);
  color: var(--brand);
  border-radius: 10rpx;
  font-size: 24rpx;
}
.item-main {
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.item-title {
  font-size: 33rpx;
  font-weight: 500;
  word-break: break-all;
}
.item-summary {
  font-size: 29rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}
.item-meta {
  font-size: 25rpx;
  color: var(--muted-ink);
  word-break: break-all;
}
.compact-warning {
  padding: 18rpx;
  font-size: 25rpx;
}
