.digital-page {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  background: #f6f1ea;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 18rpx 4rpx 8rpx;
}

.eyebrow {
  color: #8d5b3e;
  font-size: 28rpx;
  font-weight: 700;
}

.title {
  color: #251f1a;
  font-size: 58rpx;
  font-weight: 700;
}

.subtitle {
  color: #6d6258;
  font-size: 34rpx;
  line-height: 1.6;
}

.form-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  border-color: #ded3c3;
  background: #fffdfa;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-heading {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.section-title {
  color: #251f1a;
  font-size: 38rpx;
  font-weight: 700;
}

.section-note {
  color: #6d6258;
  font-size: 30rpx;
  line-height: 1.5;
}

.picker-value {
  min-height: 104rpx;
  padding: 0 24rpx;
  border: 2rpx solid #d6cabb;
  border-radius: 8rpx;
  background: #fffdfa;
  color: #251f1a;
  font-size: 36rpx;
  line-height: 104rpx;
}

.empty-text {
  padding: 30rpx;
  border: 2rpx solid #e2d7c8;
  border-radius: 8rpx;
  background: #fffdfa;
  color: #6d6258;
  font-size: 32rpx;
  line-height: 1.6;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 30rpx;
  border: 2rpx solid #e2d7c8;
  border-radius: 16rpx;
  background: #fffdfa;
}

.item-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #e9f1ec;
  color: #22745f;
  font-size: 28rpx;
  font-weight: 700;
}

.item-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-title {
  color: #251f1a;
  font-size: 36rpx;
  font-weight: 700;
}

.item-summary {
  color: #4f473f;
  font-size: 32rpx;
  line-height: 1.5;
}

.item-meta {
  color: #6d6258;
  font-size: 30rpx;
  line-height: 1.5;
}
