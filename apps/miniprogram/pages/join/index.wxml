<view class="page join-page">
  <view class="panel">
    <text class="eyebrow">加入家庭</text>
    <text class="title">接受家人邀请</text>
    <text class="subtitle">确认邀请后填写你的家庭称呼，加入同一个家庭空间。</text>
  </view>

  <view class="panel form-panel">
    <view class="status-row">
      <text class="label">邀请状态</text>
      <text class="status">{{invitationStatus}}</text>
    </view>
    <view class="field">
      <text class="label">你的称呼</text>
      <input class="input" value="{{displayName}}" bindinput="onDisplayNameInput" placeholder="例如：妈妈、哥哥、外婆" />
    </view>
    <button class="primary-action" bindtap="onJoinFamily">加入家庭</button>
  </view>
</view>
