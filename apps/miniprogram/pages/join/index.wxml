<view class="page join-page">
  <view class="join-hero">
    <view class="invite-icon">家</view>
    <text class="page-title">加入家庭</text>
    <text class="page-subtitle">家人邀请你进来。先看邀请是否有效，再写上你的称呼。</text>
  </view>

  <view class="panel form-panel">
    <view class="status-row">
      <text class="label">邀请状态</text>
      <text class="status">{{invitationStatus}}</text>
    </view>
    <view class="field">
      <text class="label">邀请码</text>
      <input class="input" value="{{codeInput}}" bindinput="onCodeInput" placeholder="请输入家人发来的数字" />
    </view>
    <button class="secondary-action" bindtap="onCheckInvitation">检查邀请码</button>
    <view class="field">
      <text class="label">你的称呼</text>
      <input class="input" value="{{displayName}}" bindinput="onDisplayNameInput" placeholder="例如：妈妈、哥哥、外婆" />
    </view>
    <text class="helper-text">如果邀请无效，请让家人重新发一次。</text>
    <button class="primary-action" bindtap="onJoinFamily">确认加入家庭</button>
  </view>
</view>
