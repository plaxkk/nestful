.join-hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}
.invite-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: var(--soft-green);
  color: var(--brand);
  font-size: 36rpx;
}
.status {
  display: block;
  color: var(--brand);
  font-size: 29rpx;
  line-height: 1.8;
  word-break: break-all;
}
