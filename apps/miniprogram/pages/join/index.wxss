.join-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.title {
  color: #1f2a24;
  font-size: 52rpx;
  font-weight: 700;
}

.subtitle {
  color: #5d6b63;
  font-size: 34rpx;
  line-height: 1.6;
}

.helper-text {
  color: #66756d;
  font-size: 30rpx;
  line-height: 1.5;
}

.form-panel {
  gap: 24rpx;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.status {
  color: #22745f;
  font-size: 34rpx;
  font-weight: 700;
}
