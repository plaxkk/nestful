<view class="page home paper-pattern">
  <view class="hero-card">
    <view class="notebook-image">
      <view class="sun-strip"></view>
      <view class="book">
        <view class="book-left"></view>
        <view class="book-right"></view>
      </view>
      <view class="tea-cup"></view>
    </view>
  </view>

  <view class="welcome-copy">
    <text class="page-title">家庭助手</text>
    <text class="page-subtitle">这是家里人一起用的小本子</text>
  </view>

  <view class="home-actions">
    <button class="primary-action pill" bindtap="onPrimaryAction">{{primaryText}}</button>
    <button class="secondary-action pill" bindtap="onJoinFamily">输入邀请码加入</button>
  </view>
</view>
