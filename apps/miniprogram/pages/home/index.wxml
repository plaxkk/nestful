<view class="page home paper-pattern">
  <view class="hero-card" wx:if="{{!hasFamily}}">
    <view class="notebook-image">
      <view class="sun-strip"></view>
      <view class="book">
        <view class="book-left"></view>
        <view class="book-right"></view>
      </view>
      <view class="tea-cup"></view>
    </view>
  </view>

  <view class="welcome-copy">
    <text class="page-title">Nestful</text>
    <text class="page-subtitle">把家庭群里的约定，变成能回应、能分工的安排</text>
  </view>

  <view class="home-actions">
    <button class="primary-action pill" bindtap="onPrimaryAction">{{primaryText}}</button>
    <button wx:if="{{hasFamily}}" class="secondary-action pill" bindtap="onCreateFamily">创建另一个家庭</button>
    <button class="secondary-action pill" bindtap="onJoinFamily">输入邀请码加入</button>
  </view>

  <view class="family-list" wx:if="{{families.length > 1}}">
    <text class="section-title">切换家庭</text>
    <button class="family-option" wx:for="{{families}}" wx:key="id" data-id="{{item.family.id}}" bindtap="onSelectFamily">
      <text class="family-option-name">{{item.family.name}}</text>
      <text class="family-option-note">{{currentFamilyId === item.family.id ? '当前家庭' : '打开'}}</text>
    </button>
  </view>
  <button class="text-button" bindtap="onOpenHelp">隐私与帮助</button>
</view>
