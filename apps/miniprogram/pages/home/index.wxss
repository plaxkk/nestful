page { background: #faf7f1; color: #26392e; }
.home { padding: 18rpx 44rpx 0; min-height: 100vh; box-sizing: border-box; }
.home button { margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; font-weight: 400; line-height: 1.5; text-align: left; }
.home button::after { border: 0; }
.family-bar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.family-switch { display: flex; align-items: center; gap: 14rpx; min-height: 92rpx; min-width: 0; flex: 1; }
.family-name { font-size: 36rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chevron { width: 12rpx; height: 12rpx; border-right: 2rpx solid #365b44; border-bottom: 2rpx solid #365b44; transform: rotate(45deg); margin-top: -6rpx; flex-shrink: 0; }
.family-tag { font-size: 22rpx; color: #6c746b; padding: 3rpx 9rpx; border: 1rpx solid #dedfd5; border-radius: 7rpx; white-space: nowrap; flex-shrink: 0; }
.member-count { color: #6c746b; font-size: 24rpx; flex-shrink: 0; }
.intro { display: flex; flex-direction: column; gap: 14rpx; padding: 22rpx 0 42rpx; }
.date { font-size: 24rpx; letter-spacing: 2rpx; color: #6c746b; }
.greeting { font-size: 54rpx; font-weight: 600; letter-spacing: 1rpx; line-height: 1.4; }
.subtitle { color: #6c746b; font-size: 28rpx; }
.gathering { padding: 36rpx; background: #f1e6d3; border-radius: 40rpx; }
.hero-heading { display: flex; justify-content: space-between; align-items: center; font-size: 25rpx; color: #925938; }
.meal-mark { border: 1rpx solid #b7906a; border-radius: 8rpx; padding: 2rpx 8rpx; font-size: 24rpx; }
.home .hero-title { font-size: 48rpx; font-weight: 600; margin: 20rpx 0 10rpx; width: 100%; overflow-wrap: break-word; }
.hero-detail { display: block; font-size: 27rpx; color: #6c746b; line-height: 1.65; word-break: break-all; }
.hero-bottom { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 34rpx; }
.hero-response { color: #626c60; font-size: 25rpx; flex: 1; min-width: 0; }
.home .hero-action,.home .welcome-primary { background: #365b44; color: #fffefa; border-radius: 24rpx; min-height: 92rpx; padding: 20rpx 28rpx; font-size: 30rpx; font-weight: 500; text-align: center; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.hero-action { flex-shrink: 0; }
.empty-title { display: block; font-size: 39rpx; font-weight: 500; line-height: 1.5; margin: 18rpx 0 10rpx; }
.gathering-empty .hero-action { margin-top: 30rpx; width: 100%; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 38rpx 0 18rpx; font-size: 32rpx; font-weight: 600; }
.section-note { color: #6c746b; font-size: 25rpx; font-weight: 400; padding: 0; }
.home .section-heading button { font-size: 25rpx; min-height: 64rpx; display: flex; align-items: center; color: #6c746b; }
.todo-list { display: flex; flex-direction: column; gap: 14rpx; }
.todo { display: flex; align-items: center; padding: 18rpx 16rpx 18rpx 24rpx; border-radius: 28rpx; background: #fffefa; gap: 12rpx; }
.home .todo-main { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0; min-height: 96rpx; }
.todo-symbol { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 20rpx; color: #365b44; background: #ecf0e7; font-size: 26rpx; flex-shrink: 0; }
.todo-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.todo-title { font-size: 30rpx; word-break: break-all; }
.todo-meta { font-size: 24rpx; color: #6c746b; }
.home .complete-task,.home .open-todo { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; color: #6c746b; font-size: 42rpx; flex-shrink: 0; }
.task-circle { width: 29rpx; height: 29rpx; border: 2rpx solid #6c746b; border-radius: 50%; }
.calm-note { display: block; font-size: 27rpx; line-height: 1.8; color: #6c746b; padding: 4rpx 0 10rpx; }
.reminder-heading { margin-bottom: 0; }
.reminder-row { border-bottom: 1rpx solid #e6e7dd; }
.home .reminder-main { display: flex; align-items: center; gap: 20rpx; width: 100%; min-height: 124rpx; padding: 18rpx 0; box-sizing: border-box; }
.reminder-mark { width: 17rpx; height: 17rpx; border: 2rpx solid #925938; border-radius: 50%; margin: 0 8rpx; flex-shrink: 0; }
.reminder-copy { display: flex; flex-direction: column; flex: 1; min-width: 0; gap: 7rpx; font-size: 30rpx; word-break: break-all; }
.reminder-meta { color: #6c746b; font-size: 24rpx; }
.row-arrow { color: #6c746b; font-size: 36rpx; }
.quick-links { display: flex; flex-wrap: wrap; gap: 44rpx; padding: 24rpx 0 12rpx; }
.home .quick-links button { display: flex; align-items: center; gap: 14rpx; min-height: 88rpx; font-size: 27rpx; color: #6c746b; }
.small-book { width: 25rpx; height: 28rpx; border: 2rpx solid currentColor; border-radius: 5rpx; position: relative; }
.small-book::after { content: ''; position: absolute; top: 0; bottom: 0; left: 6rpx; border-left: 2rpx solid currentColor; }
.small-bell { width: 22rpx; height: 24rpx; border: 2rpx solid currentColor; border-radius: 16rpx 16rpx 3rpx 3rpx; position: relative; }
.small-bell::after { content: ''; position: absolute; width: 5rpx; height: 4rpx; left: 7rpx; bottom: -7rpx; border-bottom: 2rpx solid currentColor; }
.home .more-link { min-height: 88rpx; font-size: 26rpx; color: #365b44; display: flex; align-items: center; }
.status-line { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; color: #795332; font-size: 26rpx; }
.status-line text { flex: 1; }
.home .status-line button { min-width: 88rpx; min-height: 88rpx; text-align: center; font-size: 27rpx; }
.load-state { display: flex; flex-direction: column; align-items: center; gap: 24rpx; min-height: 320rpx; justify-content: center; font-size: 28rpx; color: #6c746b; }
.home .quiet-button { min-height: 88rpx; padding: 20rpx 32rpx; color: #365b44; border: 1rpx solid #cbd4c7; border-radius: 20rpx; font-size: 28rpx; }
.loading-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: #b4c4ad; }
.welcome { min-height: calc(100vh - 90rpx); display: flex; flex-direction: column; align-items: center; padding: 110rpx 0 20rpx; box-sizing: border-box; }
.welcome-symbol { width: 150rpx; height: 150rpx; border-radius: 50%; background: #ecf0e7; position: relative; margin-bottom: 32rpx; }
.welcome-roof { width: 48rpx; height: 48rpx; border-left: 4rpx solid #365b44; border-top: 4rpx solid #365b44; position: absolute; left: 49rpx; top: 36rpx; transform: rotate(45deg); border-radius: 4rpx; }
.welcome-house { width: 58rpx; height: 48rpx; border: 4rpx solid #365b44; border-top: 0; position: absolute; left: 43rpx; top: 68rpx; border-radius: 3rpx; }
.welcome-brand { font-size: 29rpx; color: #365b44; letter-spacing: 3rpx; }
.welcome-title { font-size: 54rpx; font-weight: 500; line-height: 1.6; text-align: center; margin: 34rpx 0 20rpx; }
.welcome-title text { display: block; }
.welcome-note { text-align: center; font-size: 30rpx; line-height: 1.8; color: #6c746b; margin-bottom: 44rpx; }
.home .welcome-primary { width: 100%; min-height: 108rpx; font-size: 33rpx; margin-top: 26rpx; }
.home .welcome-secondary { width: 100%; min-height: 108rpx; font-size: 31rpx; color: #365b44; display: flex; align-items: center; justify-content: center; }
.home .welcome-help { font-size: 26rpx; color: #6c746b; min-height: 88rpx; margin-top: auto; padding-top: 30rpx; }
.welcome-error { color: #795332; font-size: 27rpx; line-height: 1.7; }
.switcher-backdrop { position: fixed; inset: 0; z-index: 30; background: rgba(32,48,40,.35); display: flex; align-items: flex-end; }
.switcher-sheet { width: 100%; padding: 32rpx 40rpx calc(28rpx + env(safe-area-inset-bottom)); background: #fffefa; border-radius: 44rpx 44rpx 0 0; box-sizing: border-box; }
.sheet-heading { display: flex; align-items: center; justify-content: space-between; font-size: 38rpx; font-weight: 500; margin-bottom: 12rpx; }
.home .sheet-heading button { min-width: 88rpx; height: 88rpx; text-align: center; font-size: 46rpx; color: #6c746b; }
.family-options { max-height: 50vh; }
.family-option { display: flex; align-items: center; gap: 16rpx; border-bottom: 1rpx solid #e6e7dd; }
.home .family-choice { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; flex: 1; min-width: 0; min-height: 136rpx; }
.family-initial { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 22rpx; background: #ecf0e7; color: #365b44; flex-shrink: 0; font-size: 30rpx; }
.family-choice-copy { display: flex; flex-direction: column; gap: 8rpx; font-size: 32rpx; flex: 1; min-width: 0; word-break: break-all; }
.choice-note { color: #6c746b; font-size: 24rpx; }
.home .set-primary { min-height: 88rpx; padding: 8rpx; font-size: 24rpx; color: #365b44; flex-shrink: 0; }
.sheet-note { display: block; color: #6c746b; font-size: 26rpx; line-height: 1.7; margin: 30rpx 0 16rpx; }
.sheet-actions { display: flex; gap: 36rpx; }
.home .sheet-actions button { font-size: 28rpx; color: #365b44; min-height: 88rpx; display: flex; align-items: center; }
@media (max-width: 350px) { .home { padding-left: 32rpx; padding-right: 32rpx; } .greeting { font-size: 50rpx; } .gathering { padding: 30rpx; } .hero-title { font-size: 44rpx; } .hero-bottom { gap: 12rpx; } .hero-response { font-size: 24rpx; } .home .hero-action { padding-left: 22rpx; padding-right: 22rpx; font-size: 28rpx; } }

/* Daily actions stay visible even when the household has no pending items. */
.intro { padding: 16rpx 0 28rpx; gap: 10rpx; }
.greeting { font-size: 46rpx; }
.home-shortcuts { display: flex; gap: 12rpx; padding: 8rpx 0 12rpx; }
.home .home-shortcuts button { flex: 1; min-width: 0; min-height: 142rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 14rpx; font-size: 25rpx; color: #365b44; }
.shortcut-mark { width: 70rpx; height: 70rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; background: #ecf0e7; font-size: 29rpx; font-weight: 500; }
.shortcut-mark.sand { background: #f1e6d3; color: #925938; }
.calm-panel { padding: 28rpx; background: #ecf0e7; border-radius: 28rpx; }
.calm-title { display: block; font-size: 31rpx; font-weight: 500; margin-bottom: 10rpx; }
.calm-panel .calm-note { padding: 0; }
.reminder-symbol { background: #f1e6d3; color: #925938; }
.home .respond-action { flex-shrink: 0; min-width: 88rpx; min-height: 88rpx; padding: 14rpx; display: flex; align-items: center; justify-content: center; color: #365b44; font-size: 27rpx; }
.pending-links { display: flex; flex-wrap: wrap; gap: 12rpx 28rpx; margin-top: 10rpx; }
.home .pending-links button { min-height: 88rpx; display: flex; align-items: center; color: #365b44; font-size: 26rpx; }
.upcoming-list { display: flex; flex-direction: column; }
.home .upcoming-row { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; min-height: 116rpx; width: 100%; border-bottom: 1rpx solid #e6e7dd; }
.upcoming-copy { display: flex; flex-direction: column; gap: 10rpx; flex: 1; min-width: 0; }
.upcoming-label { color: #6c746b; font-size: 25rpx; }
.upcoming-title { font-size: 30rpx; word-break: break-all; }

.home .section-heading { flex-wrap: nowrap; }
.home .section-heading>.section-note { flex-basis: auto; white-space: nowrap; }
