.home {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #d8e5df;
}

.title {
  color: #1f2a24;
  font-size: 56rpx;
  font-weight: 700;
}

.subtitle {
  color: #5d6b63;
  font-size: 34rpx;
  line-height: 1.6;
}

.helper-text {
  color: #66756d;
  font-size: 30rpx;
  line-height: 1.5;
}

.form-panel {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.step-title {
  color: #1f2a24;
  font-size: 38rpx;
  font-weight: 700;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-title {
  color: #1f2a24;
  font-size: 38rpx;
  font-weight: 700;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.action-item {
  padding: 30rpx;
  border-radius: 8rpx;
  background: #f9fbf8;
  border: 2rpx solid #d8e5df;
  color: #4d5d54;
  font-size: 34rpx;
  font-weight: 600;
}
