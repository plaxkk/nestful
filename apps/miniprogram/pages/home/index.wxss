.home {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 42rpx;
}

.hero-card {
  width: 100%;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 32rpx rgba(78, 52, 46, 0.06);
}

.notebook-image {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #dac7a7 0%, #f3dfbb 48%, #9b7a55 100%);
}

.sun-strip {
  position: absolute;
  left: -40rpx;
  top: 260rpx;
  width: 780rpx;
  height: 110rpx;
  background: rgba(255, 248, 246, 0.62);
  transform: rotate(-8deg);
}

.book {
  position: absolute;
  left: 110rpx;
  bottom: 90rpx;
  display: flex;
  width: 420rpx;
  height: 150rpx;
  transform: rotate(3deg);
}

.book-left,
.book-right {
  flex: 1;
  background: #fffdf7;
  border: 2rpx solid rgba(67, 42, 37, 0.18);
  box-shadow: 0 10rpx 18rpx rgba(67, 42, 37, 0.18);
}

.book-left {
  border-radius: 18rpx 8rpx 8rpx 30rpx;
}

.book-right {
  border-radius: 8rpx 18rpx 30rpx 8rpx;
}

.tea-cup {
  position: absolute;
  right: 92rpx;
  top: 230rpx;
  width: 92rpx;
  height: 72rpx;
  border-radius: 0 0 38rpx 38rpx;
  background: #fff8f6;
  box-shadow: inset 0 12rpx 0 #8d5b3e, 0 10rpx 18rpx rgba(67, 42, 37, 0.16);
}

.tea-cup::after {
  content: "";
  position: absolute;
  right: -28rpx;
  top: 18rpx;
  width: 34rpx;
  height: 34rpx;
  border: 8rpx solid #fff8f6;
  border-left: 0;
  border-radius: 0 28rpx 28rpx 0;
}

.welcome-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  text-align: center;
}

.home-actions {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding-bottom: 28rpx;
}

.pill {
  border-radius: 999rpx;
}

.family-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.family-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  min-height: 104rpx;
  margin: 0;
  padding: 24rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: left;
  line-height: 1.5;
}

.family-option-name {
  flex: 1;
  min-width: 0;
  color: #2b1611;
  font-size: 34rpx;
  font-weight: 700;
  word-break: break-all;
}

.family-option-note {
  flex-shrink: 0;
  color: #63635f;
  font-size: 30rpx;
}
