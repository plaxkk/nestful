.activity-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.activity-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.activity-meta {
  color: var(--clay);
  font-size: 27rpx;
}
.activity-desc {
  font-size: 28rpx;
  color: var(--muted-ink);
  line-height: 1.8;
  word-break: break-all;
}
.task-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}
.task-row>text {
  flex: 1;
  min-width: 240rpx;
}
.activity-card>.section-title {
  font-size: 37rpx;
}
.activity-card .form-panel {
  padding: 24rpx;
  background: var(--soft-green);
  border-radius: 20rpx;
}
