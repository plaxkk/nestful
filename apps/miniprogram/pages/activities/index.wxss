.activities-page {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  background: #fff8f6;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 18rpx 4rpx 8rpx;
}

.eyebrow {
  color: #9a4b2f;
  font-size: 30rpx;
  font-weight: 800;
}

.form-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  border-color: #ffe2db;
  background: #ffffff;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-heading {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.section-title {
  color: #2b1611;
  font-size: 38rpx;
  font-weight: 800;
}

.section-note {
  color: #44474c;
  font-size: 30rpx;
  line-height: 1.5;
}

.picker-value {
  min-height: 104rpx;
  padding: 0 24rpx;
  border: 2rpx solid #c4c6cd;
  border-radius: 24rpx;
  background: #ffffff;
  color: #2b1611;
  font-size: 36rpx;
  line-height: 104rpx;
}

.empty-text {
  padding: 30rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 24rpx;
  background: #ffffff;
  color: #44474c;
  font-size: 32rpx;
  line-height: 1.6;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.activity-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 30rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 24rpx;
  background: #ffffff;
}

.activity-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #ffe9e4;
  color: #041627;
  font-size: 30rpx;
  font-weight: 800;
}

.activity-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.activity-title {
  color: #2b1611;
  font-size: 36rpx;
  font-weight: 800;
}

.activity-meta,
.activity-desc {
  color: #44474c;
  font-size: 30rpx;
  line-height: 1.5;
}

.secondary-action.compact {
  width: auto;
  min-width: 156rpx;
  min-height: 88rpx;
  margin-top: 8rpx;
  padding: 0 22rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}

.secondary-action.danger {
  border-color: #b42318;
  color: #b42318;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-top: 6rpx;
}

.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 20rpx;
  background: #fff8f6;
}

.task-title {
  flex: 1;
  color: #2b1611;
  font-size: 30rpx;
  line-height: 1.5;
}
