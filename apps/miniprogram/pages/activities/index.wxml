<view class="page activities-page">
  <view class="header">
    <text class="eyebrow">把家人重新约到一起</text>
    <text class="page-title">家庭活动日</text>
    <text class="page-subtitle">发起一次吃饭、散步、视频聊天或家庭小会，让家人知道什么时候一起出现。</text>
  </view>

  <view class="panel form-panel">
    <view class="section-heading">
      <text class="section-title">发起活动</text>
      <text class="section-note">先把时间、地点和一句说明写清楚。</text>
    </view>
    <view class="field">
      <text class="label">活动名称</text>
      <input class="input" value="{{titleInput}}" bindinput="onTitleInput" placeholder="例如：周末家庭聚会" />
    </view>
    <view class="field">
      <text class="label">时间</text>
      <input class="input" value="{{startsAtInput}}" bindinput="onStartsAtInput" placeholder="例如：2026-05-24 10:00" />
    </view>
    <view class="field">
      <text class="label">地点</text>
      <input class="input" value="{{locationInput}}" bindinput="onLocationInput" placeholder="例如：家里、小区门口、线上视频" />
    </view>
    <view class="field">
      <text class="label">说明</text>
      <input class="input" value="{{descriptionInput}}" bindinput="onDescriptionInput" placeholder="例如：一起吃饭、聊聊近况" />
    </view>
    <view class="field">
      <text class="label">协作任务</text>
      <input class="input" value="{{taskInput}}" bindinput="onTaskInput" placeholder="例如：准备水果、订餐、带相机" />
    </view>
    <view class="field">
      <text class="label">任务负责人</text>
      <picker mode="selector" range="{{memberOptions}}" value="{{taskAssigneeIndex}}" bindchange="onTaskAssigneeChange">
        <view class="picker-value">{{memberOptions[taskAssigneeIndex] || '我来负责'}}</view>
      </picker>
    </view>
    <button class="primary-action" bindtap="onCreateActivity">发起家庭活动</button>
  </view>

  <view class="section">
    <view class="section-heading">
      <text class="section-title">已经发起的活动</text>
      <text class="section-note">复制说明发到家庭群，家人更容易看懂。</text>
    </view>
    <text class="empty-text" wx:if="{{!loading && activities.length === 0}}">还没有活动。先发起一次家庭聚会、散步或视频聊天。</text>
    <view class="activity-list">
      <view class="activity-row" wx:for="{{activities}}" wx:key="id">
        <view class="activity-mark">活动</view>
        <view class="activity-main">
          <text class="activity-title">{{item.title}}</text>
          <text class="activity-meta">{{item.startsAtText}} · {{item.locationText}} · {{item.statusLabel}}</text>
          <text class="activity-desc">{{item.descriptionText}}</text>
          <text class="activity-desc">{{item.participantSummaryText}}</text>
          <text class="activity-desc">{{item.taskSummaryText}}</text>
          <text class="activity-desc" wx:if="{{item.memoryText}}">{{item.memoryText}}</text>
          <view class="action-row">
            <button class="secondary-action compact" data-id="{{item.id}}" data-rsvp="accepted" bindtap="onRsvpActivity">确认参加</button>
            <button class="secondary-action compact" data-id="{{item.id}}" data-rsvp="tentative" bindtap="onRsvpActivity">待定</button>
            <button class="secondary-action compact" data-id="{{item.id}}" data-rsvp="declined" bindtap="onRsvpActivity">无法参加</button>
          </view>
          <view class="action-row">
            <button class="secondary-action compact" data-id="{{item.id}}" bindtap="onCreateTask">加任务</button>
            <button class="secondary-action compact" data-text="{{item.shareText}}" bindtap="onCopyShareText">复制说明</button>
          </view>
          <view class="task-list" wx:if="{{item.tasks.length > 0}}">
            <view class="task-row" wx:for="{{item.tasks}}" wx:for-item="task" wx:key="id">
              <text class="task-title">{{task.title}}</text>
              <button wx:if="{{task.status !== 'done'}}" class="secondary-action compact" data-id="{{item.id}}" data-task-id="{{task.id}}" data-status="done" bindtap="onUpdateTaskStatus">完成任务</button>
            </view>
          </view>
          <view class="action-row" wx:if="{{item.canFinish}}">
            <button class="secondary-action compact" data-id="{{item.id}}" data-status="completed" bindtap="onUpdateActivityStatus">完成活动</button>
            <button class="secondary-action compact danger" data-id="{{item.id}}" data-status="cancelled" bindtap="onUpdateActivityStatus">取消活动</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
