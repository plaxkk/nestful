page {
  background: #f7f7f2;
  color: #1f2a24;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

.panel {
  padding: 34rpx;
  border: 2rpx solid #d8e5df;
  border-radius: 8rpx;
  background: #ffffff;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.label {
  color: #415048;
  font-size: 30rpx;
  font-weight: 600;
}

.input {
  height: 104rpx;
  padding: 0 24rpx;
  border: 2rpx solid #c9d8d1;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1f2a24;
  font-size: 36rpx;
}

.primary-action {
  width: 100%;
  min-height: 108rpx;
  margin: 0;
  background: #22745f;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.secondary-action {
  width: 100%;
  min-height: 98rpx;
  margin: 0;
  background: #eef5f1;
  color: #22745f;
  border: 2rpx solid #b8d1c7;
  border-radius: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}
