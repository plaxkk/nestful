page {
  background: #fff8f6;
  color: #2b1611;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 36rpx 44rpx 48rpx;
  box-sizing: border-box;
}

.paper-pattern {
  background-color: #fff8f6;
  background-image: radial-gradient(#ffdad2 2rpx, transparent 2rpx);
  background-size: 44rpx 44rpx;
}

.panel {
  padding: 34rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 24rpx;
  background: #ffffff;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.label {
  color: #2b1611;
  font-size: 30rpx;
  font-weight: 700;
}

.input {
  height: 104rpx;
  padding: 0 24rpx;
  border: 3rpx solid #c4c6cd;
  border-radius: 16rpx;
  background: #ffffff;
  color: #2b1611;
  font-size: 36rpx;
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 112rpx;
  margin: 0;
  padding: 0 28rpx;
  background: #041627;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.secondary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 98rpx;
  margin: 0;
  padding: 0 26rpx;
  background: transparent;
  color: #041627;
  border: 3rpx solid #041627;
  border-radius: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-title {
  color: #041627;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.18;
}

.page-subtitle {
  color: #44474c;
  font-size: 34rpx;
  line-height: 1.6;
}

.section-title {
  color: #2b1611;
  font-size: 38rpx;
  font-weight: 800;
}

.section-note,
.helper-text,
.empty-text {
  color: #63635f;
  font-size: 30rpx;
  line-height: 1.55;
}

.empty-text {
  padding: 30rpx;
  border: 2rpx solid #ffe2db;
  border-radius: 20rpx;
  background: #ffffff;
}

.picker-value {
  min-height: 104rpx;
  padding: 0 24rpx;
  border: 3rpx solid #c4c6cd;
  border-radius: 16rpx;
  background: #ffffff;
  color: #2b1611;
  font-size: 36rpx;
  line-height: 104rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  color: #041627;
  font-size: 38rpx;
  font-weight: 800;
}

.back-button {
  position: absolute;
  left: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  color: #041627;
  font-size: 48rpx;
  font-weight: 700;
}
