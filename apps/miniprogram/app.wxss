page {
  --paper: #faf7f1;
  --surface: #fffefa;
  --ink: #26392e;
  --muted-ink: #6c746b;
  --brand: #365b44;
  --soft-green: #ecf0e7;
  --sand: #f1e6d3;
  --line: #e6e7dd;
  --clay: #925938;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}
button, input, textarea { font-family: inherit; }
button { box-sizing: border-box; }
button::after { border: 0; }
button[disabled] { opacity: .55; }
.page { min-height: 100vh; padding: 30rpx 44rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; display: flex; flex-direction: column; gap: 32rpx; }
.header,.copy-block { display: flex; flex-direction: column; gap: 12rpx; padding: 12rpx 0 4rpx; }
.page-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.heading-copy { display: flex; flex-direction: column; gap: 12rpx; flex: 1; min-width: 0; }
.eyebrow { color: var(--clay); font-size: 23rpx; letter-spacing: 2rpx; font-weight: 400; }
.page-title { color: var(--ink); font-size: 50rpx; font-weight: 600; line-height: 1.4; word-break: break-all; }
.page-subtitle { color: var(--muted-ink); font-size: 28rpx; line-height: 1.75; }
.family-context { display: block; color: var(--brand); font-size: 25rpx; word-break: break-all; }
.section { display: flex; flex-direction: column; gap: 20rpx; }
.section-heading,.editor-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx 20rpx; }
.section-title { word-break: break-all; color: var(--ink); font-size: 33rpx; font-weight: 600; line-height: 1.5; }
.section-note,.helper-text { display: block; color: var(--muted-ink); font-size: 26rpx; line-height: 1.75; word-break: break-word; }
.section-heading>.section-note { flex-basis: 100%; }
.panel { padding: 30rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: var(--surface); box-sizing: border-box; }
.form-panel,.member-editor { display: flex; flex-direction: column; gap: 26rpx; }
.field { display: flex; flex-direction: column; gap: 12rpx; min-width: 0; }
.label { color: var(--ink); font-size: 28rpx; font-weight: 500; }
.input { box-sizing: border-box; width: 100%; min-width: 0; height: 96rpx; padding: 0 22rpx; border: 2rpx solid #cbd4c7; border-radius: 16rpx; background: var(--surface); color: var(--ink); font-size: 31rpx; }
.textarea { box-sizing: border-box; width: 100%; min-height: 180rpx; padding: 22rpx; border: 2rpx solid #cbd4c7; border-radius: 16rpx; background: var(--surface); color: var(--ink); font-size: 30rpx; line-height: 1.75; }
.picker-value { position: relative; box-sizing: border-box; min-height: 96rpx; display: flex; align-items: center; padding: 18rpx 54rpx 18rpx 22rpx; border: 2rpx solid #cbd4c7; border-radius: 16rpx; background: var(--surface); color: var(--ink); font-size: 30rpx; line-height: 1.6; word-break: break-all; }
.picker-value::after { content: ''; position: absolute; right: 24rpx; top: 40rpx; width: 12rpx; height: 12rpx; border-right: 2rpx solid var(--muted-ink); border-bottom: 2rpx solid var(--muted-ink); transform: rotate(45deg); }
.page .primary-action,.page .secondary-action,.page .danger-action { box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: 100%; min-height: 96rpx; margin: 0; padding: 20rpx 26rpx; border-radius: 20rpx; font-size: 31rpx; font-weight: 500; line-height: 1.5; text-align: center; }
.primary-action { background: var(--brand); color: var(--surface); border: 1rpx solid var(--brand); }
.secondary-action { background: var(--surface); color: var(--brand); border: 2rpx solid #cbd4c7; }
.danger-action { background: #faf0e9; color: #9b4b33; border: 1rpx solid #ead8cd; }
.text-button { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin: 0; padding: 14rpx 18rpx; border: 0; border-radius: 12rpx; background: transparent; color: var(--brand); font-size: 27rpx; line-height: 1.5; white-space: normal; }
.danger,.text-button.danger { color: #9b4b33; }
.small-action { flex-shrink: 0; display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin: 0; padding: 14rpx 22rpx; border: 0; border-radius: 18rpx; background: var(--soft-green); color: var(--brand); font-size: 27rpx; line-height: 1.5; }
.action-row,.date-time-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.action-row>.text-button { min-width: 108rpx; }
.action-row>.secondary-action { width: auto; flex: 1; min-width: 130rpx; }
.date-time-row>.field { flex: 1; min-width: 220rpx; }
.switch-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 100rpx; }
.switch-row>.label { flex: 1; }
.empty-text { display: block; padding: 32rpx; border: 1rpx dashed #d5d9ca; border-radius: 24rpx; background: transparent; color: var(--muted-ink); font-size: 28rpx; line-height: 1.8; }
.notice,.warning-text { display: block; padding: 24rpx; border: 0; border-radius: 20rpx; background: var(--sand); color: #795332; font-size: 26rpx; line-height: 1.8; }
.loading-state { display: block; padding: 24rpx 0; color: var(--muted-ink); font-size: 28rpx; }
.error-state { display: flex; flex-direction: column; align-items: flex-start; gap: 10rpx; padding: 24rpx 30rpx; border: 1rpx solid #e4d8c7; border-radius: 24rpx; background: var(--surface); color: #795332; font-size: 28rpx; }
.pill,.status-pill { display: inline-flex; align-items: center; gap: 8rpx; padding: 8rpx 16rpx; border-radius: 12rpx; background: var(--soft-green); color: var(--brand); font-size: 24rpx; line-height: 1.5; }
.choice-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.choice-button { flex: 1; min-width: 120rpx; min-height: 88rpx; margin: 0; padding: 18rpx 12rpx; border: 1rpx solid var(--line); border-radius: 16rpx; background: var(--surface); color: var(--muted-ink); font-size: 27rpx; line-height: 1.5; text-align: center; }
.choice-button.selected { border-color: var(--brand); background: var(--soft-green); color: var(--brand); font-weight: 500; }
.agreement { display: flex; align-items: center; gap: 12rpx; min-height: 88rpx; color: var(--muted-ink); font-size: 27rpx; line-height: 1.75; }
.agreement checkbox { flex-shrink: 0; }
.share-overlay { position: fixed; inset: 0; z-index: 30; background: rgba(32,48,40,.35); display: flex; align-items: flex-end; padding: 20rpx; box-sizing: border-box; }
.share-sheet { width: 100%; display: flex; flex-direction: column; gap: 24rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.request-row { display: flex; flex-direction: column; gap: 12rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
@media (max-width:350px) { .page { padding-left: 32rpx; padding-right: 32rpx; } .page-title { font-size: 46rpx; } .panel { padding: 26rpx; } }

.page .text-button { width: auto; max-width: 100%; }
